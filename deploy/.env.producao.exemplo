# Copie para .env.producao e preencha. NUNCA envie este arquivo para o GitHub.
# Gere senhas longas e diferentes (ex.: comando "openssl rand -hex 24").

# Seu domínio (já apontando para o IP do servidor) e o endereço completo
DOMINIO=radar.seudominio.com.br
APP_URL=https://radar.seudominio.com.br
APP_ENV=production

# Banco de dados
DB_PASS=troque-esta-senha-do-banco
DB_ROOT_PASS=troque-esta-senha-root

# O sistema fica atrás do Caddy dentro do Docker. Isto faz o limite de tentativas por IP enxergar o visitante real.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,127.0.0.1

# Fonte de dados (DJEN). Deixe assim.
DJEN_URL=https://comunicaapi.pje.jus.br/api/v1/comunicacao
DJEN_TIMEOUT=15

# Datajud (CNJ): andamento completo do processo. A chave é pública: copie de
# https://datajud-wiki.cnj.jus.br/api-publica/acesso (sem ela, o sistema usa só o Diário).
DATAJUD_API_KEY=
DATAJUD_TIMEOUT=20

# SÓ preencha se o teste da fonte der "403" no servidor (veja deploy/LEIA-ME-NO-AR.md, parte 5).
# Exemplo: http://usuario:senha@gateway.exemplo.com:porta
HTTP_PROXY_URL=

# E-mail (avisos e convites). Sem isto, NENHUM e-mail sai (e a recuperação de senha por e-mail não funciona).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=tls
