# Copie para .env e preencha. O arquivo .env não vai para o repositório.

# ── Datajud (API pública do CNJ) ──────────────────────────────────────────────
# A chave é pública e está na documentação do CNJ:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=
# O Datajud às vezes leva mais de um minuto para responder; não deixe curto demais
DATAJUD_TIMEOUT=90

# ── Comunica / DJEN ───────────────────────────────────────────────────────────
# Não precisa de chave. Ajuste só se quiser.
COMUNICA_TIMEOUT=12
COMUNICA_TAMANHO_PAGINA=100

# ── Proxies (opcional) ────────────────────────────────────────────────────────
# Só necessário se você consultar de fora do Brasil ou em volume alto: a API do
# Comunica é do gov.br e recusa saídas estrangeiras. Rodando de um IP brasileiro,
# deixe tudo em branco.
# Lista fixa, separada por vírgula: http://usuario:senha@ip:porta
CONSULTA_PROXIES=

# Gateway residencial que abre um IP por porta (informe host, credenciais e o range)
CONSULTA_GATEWAY_HOST=
CONSULTA_GATEWAY_LOGIN=
CONSULTA_GATEWAY_SENHA=
CONSULTA_GATEWAY_PORTA_INICIAL=10000
CONSULTA_GATEWAY_PORTAS=0

# Provedor com API de listagem (opcional; exemplo implementado: Proxy Seller)
PROXYSELLER_API_KEY=

# Quantos proxies tentar ao mesmo tempo e o teto de tentativas por consulta
CONSULTA_PROXIES_PARALELO=4
CONSULTA_PROXIES_MAX=16

# ── Boa vizinhança ────────────────────────────────────────────────────────────
# Acrescente uma identificação sua ao User-Agent (ex.: "MeuProjeto/1.0 (contato@exemplo.com)")
CONSULTA_USER_AGENT_EXTRA=
# Pausa, em segundos, entre páginas de uma mesma busca
CONSULTA_PAUSA_PAGINAS=0

# ── API REST (consulta-processos api) ────────────────────────────────────────
# Clientes, chaves e cotas ficam no banco do painel (/admin). Crie seu acesso com
#   consulta-processos admin criar voce@empresa.com.br
API_BANCO=dados/api.db
# Cookie do painel só por HTTPS. 0 apenas para teste local sem TLS em navegador que exija.
API_COOKIE_SEGURO=1
# Faixas de IP que podem abrir o painel, ex.: 172.16.0.0/16,200.1.2.3/32. Vazio = todos.
PAINEL_IPS_PERMITIDOS=
# Chaves internas (sem cota), separadas por vírgula, no formato nome:chave.
# Gere com `consulta-processos nova-chave <nome>` (mínimo 32 caracteres).
# Deixe este arquivo com permissão 600.
API_CHAVES=
# Requisições por minuto, por cliente
API_LIMITE_POR_MINUTO=60
# Tentativas com chave errada por minuto, por IP, antes de bloquear
API_FALHAS_POR_MINUTO=10
# 0 desliga /docs, /redoc e /openapi.json
API_DOCS=1
# IPs do proxy reverso (HAProxy) cujo X-Forwarded-For é aceito
API_PROXY_CONFIAVEL=127.0.0.1

# ── Monitor (consulta-processos monitor ...) ─────────────────────────────────
# Onde ficam o que você acompanha, as publicações e os prazos (SQLite).
# O banco guarda o teor das intimações: inclua no backup e proteja o arquivo.
MONITOR_BANCO=dados/monitor.db
