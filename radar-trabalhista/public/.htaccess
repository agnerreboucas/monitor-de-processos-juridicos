# Apache / Hostinger: /api/* vai para a aplicação PHP; o resto é a tela estática.
Options -Indexes
RewriteEngine On
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^ index.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ app/index.html [L]
# Nunca expor arquivos de configuração
<FilesMatch "^\.(env|git)">
  Require all denied
</FilesMatch>
