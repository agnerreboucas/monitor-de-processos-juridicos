# Apache / Hostinger: /api/* vai para a aplicação PHP; / é a página de apresentação; /entrar é o sistema.
Options -Indexes
DirectoryIndex app/inicio.html
RewriteEngine On
# o Apache/CGI às vezes esconde o cabeçalho Authorization do PHP: repassa
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_URI} ^(/public)?/(api|v1)/
RewriteRule ^ index.php [L]
RewriteRule ^entrar/?$ app/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ app/index.html [L]
# Nunca expor arquivos de configuração
<FilesMatch "^\.(env|git)">
  Require all denied
</FilesMatch>
