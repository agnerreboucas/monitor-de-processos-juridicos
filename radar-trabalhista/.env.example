# Copie para .env. Nunca versione o .env.
APP_ENV=production
APP_URL=https://radar.exemplo.com.br
# Chave longa e aleatória (php -r 'echo bin2hex(random_bytes(32));'). Usada para assinar tokens.
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=radar
DB_USER=radar
DB_PASS=

# Fonte de monitoramento (APIs públicas do CNJ; o DJEN só responde a IP do Brasil)
DJEN_URL=https://comunicaapi.pje.jus.br/api/v1/comunicacao
DJEN_TIMEOUT=15

# Datajud (CNJ): andamento completo do processo. A chave é pública: copie de
# https://datajud-wiki.cnj.jus.br/api-publica/acesso (sem ela, o sistema usa só o Diário).
DATAJUD_API_KEY=
DATAJUD_TIMEOUT=20

# Venda: o que o cliente vê na tela Plano (sem gateway de pagamento).
# Ex.: PAYMENT_INFO=Pix (CNPJ 00.000.000/0001-00). Depois de pagar, envie o comprovante para financeiro@seudominio.com.br
PAYMENT_INFO=
# E-mail ou WhatsApp de suporte, mostrado ao cliente
SUPPORT_CONTACT=
# Opcional: proxy HTTP, ex.: http://usuario:senha@host:porta
HTTP_PROXY_URL=

# E-mail (notificações)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=tls

# Sessão e login
SESSION_NAME=radar_sid
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
